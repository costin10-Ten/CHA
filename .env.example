# =============================================================================
# 個人知識庫與風險溝通產製系統 — 環境變數範本
# 複製為 .env.local（本機）或設定於 Vercel Project Settings（雲端）
# .env.local 已被 .gitignore 排除，絕對不要提交任何真實金鑰
# =============================================================================

# --- 前端可讀取（會被打包進瀏覽器，只能放 publishable key）-------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- 僅限伺服器端（Server Actions／Route Handlers／Edge Functions）-----------
# 以下三個金鑰不得出現在任何 NEXT_PUBLIC_ 變數或前端程式碼中
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- 模型 -------------------------------------------------------------------
# mock | openai | anthropic；測試與 CI 一律使用 mock，不呼叫付費 API
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- 應用程式 ---------------------------------------------------------------
# 供 Auth redirect 使用；Vercel 上未設定時會退回 VERCEL_URL
APP_URL=http://localhost:3000
# 保護 Supabase Cron／排程 Route Handler 的共用密鑰
CRON_SECRET=change-me-to-a-long-random-string
